# =============================================================================
# Jeevan Dental & Aesthetic Clinic — environment variables
# Copy this file to `.env.local` and fill in real values. `.env*` is git-ignored.
# =============================================================================

# --- Site -------------------------------------------------------------------
# Public base URL of the deployed site (no trailing slash). Used for canonical
# URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=

# Public browser key. Either name works:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...            (legacy anon key)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_... (new publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. NEVER exposed to the browser. Either name works:
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   (legacy service_role key)
#   SUPABASE_SECRET_KEY=sb_secret_...         (new secret key)
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ------------------------------------------------------------
# Not required — the site uses a keyless Google Maps embed.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
npm run create-admin "admin@jeevandental.in" "ChooseAStrongPassword123" "Clinic Admin"
## --- Optional ------------------------------------------------------------
##  Email:    admin@jeevandental.in
##  Password: Admin@123
